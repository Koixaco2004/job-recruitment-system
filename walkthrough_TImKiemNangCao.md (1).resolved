      "requiredDegree": "university",
      "slots": 2,
      "deadline": "2026-05-30T00:00:00.000Z",
      "status": "published",
      "createdAt": "2026-04-20T08:00:00.000Z",
      "company": {
        "id": 5,
        "name": "Tech Corp Vietnam",
        "logoUrl": "https://...",
        "bannerUrl": "https://...",
        "description": "...",
